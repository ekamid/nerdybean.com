# Canonical public URL of the site (no trailing slash). Used for canonical links,
# sitemap, RSS, Open Graph and JSON-LD. On Netlify it falls back to the site's primary URL.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- /admin (see README → Admin). Never commit real values. ---
# GitHub OAuth App, used only to check who is signing in. Use a separate OAuth App for local
# development (callback http://localhost:3000/admin/callback) and for production
# (callback https://<your-domain>/admin/callback).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Signs the session cookie. At least 32 random characters: `openssl rand -hex 32`
ADMIN_SESSION_SECRET=
# Production only: fine-grained personal access token for this repo with
# "Contents: Read and write". The admin commits with it.
GITHUB_CONTENT_TOKEN=
